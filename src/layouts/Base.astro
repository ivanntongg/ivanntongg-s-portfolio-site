---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  /** Absolute or site-relative path to the social preview image. */
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = new URL(ogImage ?? '/og-default.png', Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Only the two latin files are preloaded. latin-ext and italic are
         behind unicode-range and must stay lazy, or we pay for glyphs most
         pages never use. -->
    <link rel="preload" href="/fonts/newsreader-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/plexsans-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="min-h-dvh flex flex-col antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:rounded focus:bg-ink focus:px-3 focus:py-2 focus:text-surface"
      >Skip to content</a
    >
    <Nav />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />

    <script is:inline>
      // Plays a recording only while it is on screen, and never for a reader
      // who has asked for reduced motion — they get controls instead. One
      // observer for the page rather than a listener per video.
      (() => {
        const vids = document.querySelectorAll('video[data-autoplay-in-view]');
        if (!vids.length) return;
        const still = matchMedia('(prefers-reduced-motion: reduce)');
        const apply = () => {
          if (still.matches) {
            vids.forEach((v) => { v.pause(); v.controls = true; v.loop = false; });
            return;
          }
          vids.forEach((v) => { v.controls = false; v.loop = true; });
          const io = new IntersectionObserver(
            (entries) => entries.forEach((e) => {
              const v = e.target;
              if (e.isIntersecting) { v.play().catch(() => { v.controls = true; }); }
              else v.pause();
            }),
            { threshold: 0.25 }
          );
          vids.forEach((v) => io.observe(v));
        };
        apply();
        still.addEventListener('change', apply);
      })();
    </script>
  </body>
</html>

---
import Base from '../layouts/Base.astro';
---
<Base title="Not found" description="That page does not exist.">
  <section class="mx-auto w-full max-w-(--container-measure) px-6 py-40 text-center">
    <h1 class="t-title">Not found</h1>
    <p class="mt-4 text-ink-muted">That page does not exist.</p>
    <a
      href="/"
      class="mt-8 inline-block underline decoration-ink-faint underline-offset-3 transition-colors hover:decoration-accent"
      >Back to work</a
    >
  </section>
</Base>

---
import Base from '../layouts/Base.astro';
---
<Base title="Not found" description="That page does not exist.">
  <section class="mx-auto w-full max-w-(--container-measure) px-6 py-32 text-center">
    <h1 class="font-serif text-4xl tracking-tight">Not found</h1>
    <p class="mt-3 text-ink-muted">That page does not exist.</p>
    <a href="/" class="mt-6 inline-block underline decoration-ink-faint underline-offset-3 hover:decoration-accent">Back to work</a>
  </section>
</Base>

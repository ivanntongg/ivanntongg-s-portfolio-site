---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import { SITE } from '../consts';

const work = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
---
<Base title={`${SITE.name} — ${SITE.role}`} description={SITE.tagline}>
  <section class="mx-auto w-full max-w-(--container-wide) px-6 pt-12 pb-24 sm:px-10 sm:pt-20">
    <h1 class="max-w-[22ch] font-serif text-[clamp(2.25rem,6vw,var(--text-display))] leading-[1.05] tracking-[-0.03em]">
      {SITE.tagline}
    </h1>
  </section>

  <section class="mx-auto w-full max-w-(--container-wide) px-6 sm:px-10">
    <h2 class="border-t border-rule pt-6 text-[0.8125rem] font-medium tracking-wide text-ink-muted uppercase">
      Selected work
    </h2>
    <ul class="mt-10 grid gap-x-10 gap-y-16 sm:grid-cols-2">
      {work.map((entry) => (
        <li><WorkCard entry={entry} /></li>
      ))}
    </ul>
    {work.length === 0 && (
      <p class="mt-10 text-ink-muted">
        No published case studies yet. Add an .mdx file under src/content/work/.
      </p>
    )}
  </section>
</Base>

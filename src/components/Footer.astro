---
import { SITE } from '../consts';
---
<footer class="mx-auto w-full max-w-(--container-wide) px-6 pt-32 pb-16 sm:px-10">
  <div class="flex flex-wrap items-baseline justify-between gap-6 border-t border-rule pt-8">
    <p class="t-meta text-ink-muted">
      Open to new work.
      <a
        href={`mailto:${SITE.email}`}
        class="text-ink underline decoration-ink-faint underline-offset-3 transition-colors hover:decoration-accent"
        >Get in touch</a
      >.
    </p>
    <ul class="flex flex-wrap gap-5">
      {SITE.links.map((l) => (
        <li>
          <a href={l.href} class="t-meta text-ink-muted transition-colors hover:text-ink">{l.label}</a>
        </li>
      ))}
    </ul>
  </div>
</footer>

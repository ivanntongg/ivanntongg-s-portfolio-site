---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props { entry: CollectionEntry<'work'> }
const { entry } = Astro.props;
const { title, summary, cover, coverAlt, role, timeframe, tags } = entry.data;
---
<a href={`/work/${entry.id}/`} class="group block">
  <div class="overflow-hidden rounded-lg bg-surface-sunk p-2">
    <Image
      src={cover}
      alt={coverAlt}
      widths={[480, 800, 1200]}
      sizes="(min-width: 768px) 34rem, 92vw"
      class="aspect-16/10 w-full rounded-md border border-rule object-cover transition-transform duration-500 ease-out group-hover:scale-[1.015]"
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="mt-5">
    {tags.length > 0 && <p class="t-label">{tags.join(' · ')}</p>}
    <h3 class="mt-2 font-serif text-lead leading-snug tracking-[-0.02em] text-balance">
      {title}
    </h3>
    <p class="t-meta mt-2 max-w-[34rem] text-ink-muted">{summary}</p>
    <p class="t-meta mt-3 text-ink-muted">{role} &middot; {timeframe}</p>
  </div>
</a>

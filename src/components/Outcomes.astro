---
interface Props {
  outcomes: readonly { label: string; value?: string }[];
}
const { outcomes } = Astro.props;

// Quantified outcomes get the stat treatment; qualitative ones read as a list.
// Mixing them in one grid makes the un-numbered ones look like a mistake.
const stats = outcomes.filter((o) => o.value);
const claims = outcomes.filter((o) => !o.value);
---
{stats.length > 0 && (
  <dl class="grid grid-cols-2 gap-x-8 gap-y-8 sm:grid-cols-3">
    {stats.map((o) => (
      <div>
        <dd class="t-title font-normal">{o.value}</dd>
        <dt class="t-meta mt-3 text-ink-muted">{o.label}</dt>
      </div>
    ))}
  </dl>
)}
{claims.length > 0 && (
  <ul class:list={['max-w-(--container-measure) space-y-3', stats.length > 0 && 'mt-12']}>
    {claims.map((o) => (
      <li class="flex gap-4">
        <span aria-hidden="true" class="mt-3 h-px w-5 shrink-0 bg-ink-faint"></span>
        <span>{o.label}</span>
      </li>
    ))}
  </ul>
)}
